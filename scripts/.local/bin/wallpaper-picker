#!/usr/bin/env bash
# Wallpaper picker using rofi — supports subfolder navigation

# Resolve sibling script by path, not by name: Hyprland's exec environment
# (unlike an interactive shell) doesn't have ~/.local/bin on PATH, so a bare
# `wallpaper-set` call silently fails to be found when run from a keybind.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

WALLPAPER_DIR="$HOME/.config/hypr/Wallpapers"
current_dir="$WALLPAPER_DIR"

while true; do
    # Build list: add ".." if inside a subfolder, then list contents
    entries=""
    if [[ "$current_dir" != "$WALLPAPER_DIR" ]]; then
        entries=".."$'\n'
    fi
    entries+="$(ls "$current_dir")"

    selected=$(echo "$entries" | rofi -dmenu -p " Wallpaper" -i)
    [[ -z "$selected" ]] && exit 0

    target="$current_dir/$selected"

    if [[ "$selected" == ".." ]]; then
        current_dir="$(dirname "$current_dir")"
    elif [[ -d "$target" ]]; then
        current_dir="$target"
    elif [[ -f "$target" ]]; then
        "$SCRIPT_DIR/wallpaper-set" "$target"
        exit 0
    fi
done
