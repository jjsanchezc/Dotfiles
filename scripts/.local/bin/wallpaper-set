#!/usr/bin/env bash
# Usage: wallpaper-set <image_path>
# Changes wallpaper and regenerates Material You color theme via matugen

if [[ -z "$1" ]]; then
    echo "Usage: wallpaper-set <image_path>" >&2
    exit 1
fi

WALLPAPER="$(realpath "$1")"

if [[ ! -f "$WALLPAPER" ]]; then
    echo "Error: file not found: $WALLPAPER" >&2
    exit 1
fi

hyprctl hyprpaper preload "$WALLPAPER"
hyprctl hyprpaper wallpaper ",$WALLPAPER"

# Guardar último wallpaper para que ags-watch lo re-aplique al boot
echo "$WALLPAPER" > "${XDG_CACHE_HOME:-$HOME/.cache}/current-wallpaper"

# Actualizar hyprpaper.conf para que persista en reboots. Este archivo se
# regenera completo en cada cambio de wallpaper, así que cualquier opción
# estática (como splash) tiene que escribirse aquí también, o se pierde.
HYPRPAPER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprpaper.conf"
printf 'splash = false\npreload = %s\nwallpaper = ,contain:%s\n' "$WALLPAPER" "$WALLPAPER" > "$HYPRPAPER_CONF"

# Wallpapers inside a fixed-theme folder use that theme's real palette
# instead of a Material You tint derived from the image. Anything else
# stays fully automatic.
THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/themes"
case "$WALLPAPER" in
    */Wallpapers/everforest/*) matugen json "$THEMES_DIR/everforest.json" ;;
    */Wallpapers/gruvbox/*)    matugen json "$THEMES_DIR/gruvbox.json" ;;
    */Wallpapers/catppuccin/*) matugen json "$THEMES_DIR/catppuccin.json" ;;
    # --source-color-index 0 picks the most dominant color automatically.
    # Without it, an image with several similarly-dominant colors makes
    # matugen prompt interactively for which one to use — that prompt
    # needs a TTY, so it silently does nothing when run from a keybind.
    *)                         matugen image "$WALLPAPER" --source-color-index 0 ;;
esac

# Note: hyprlock's background image is intentionally NOT tied to $WALLPAPER —
# it stays pinned to a fixed image (see matugen/templates/hyprlock.conf.in)
# regardless of what the desktop wallpaper is. Only its colors (accent/text/
# input-field) follow the current theme, same as everything else.
