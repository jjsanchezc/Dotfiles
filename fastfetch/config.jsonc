{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Arch",
    "color": {
      "1": "38;2;122;132;120",
      "2": "38;2;122;132;120"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "38;2;122;132;120"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;122;132;120",
        "at": "38;2;122;132;120",
        "host": "38;2;122;132;120"
      }
    },
    {
      "type": "custom",
      "format": "┌─────────────────────────────────────────────────┐",
      "outputColor": "38;2;122;132;120"
    },
    "break",
    {
      "type": "os",
      "key": " ╭─ ",
      "keyColor": "38;2;167;192;128"
    },
    {
      "type": "kernel",
      "key": " ├─ ",
      "keyColor": "38;2;167;192;128"
    },
    {
      "type": "packages",
      "key": " ╰─ 󰏗",
      "keyColor": "38;2;167;192;128"
    },
    "break",
    // {
    //   "type": "de",
    //   "key": " ╭─ ",
    //   "keyColor": "38;2;224;107;116"
    // },
    {
      "type": "terminal",
      "key": " ╭─ ",
      "keyColor": "38;2;127;187;179"
    },
    {
      "type": "shell",
      "key": " ╰─ ",
      "keyColor": "38;2;127;187;179"
    },
    "break",
    {
      "type": "host",
      "key": " ╭─ ",
      "keyColor": "38;2;219;188;127"
    },
    {
      "type": "cpu",
      "key": " ├─ 󰍛",
      "keyColor": "38;2;219;188;127"
    },
    {
      "type": "memory",
      "key": " ╰─ ",
      "keyColor": "38;2;219;188;127"
    },
    "break",
    {
      "type": "uptime",
      "key": "  󰄉",
      "keyColor": "38;2;167;192;128"
    },
    "break",
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    }
  ]
}
